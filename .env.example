NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/leadforge
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5433/leadforge

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=24

SCRAPER_CONCURRENCY=3
WORKER_CONCURRENCY=3
SCRAPER_REQUEST_DELAY_MS=2000
SCRAPER_REQUEST_TIMEOUT_MS=10000
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_PROXY_URL=

# Chrome CDP (Social Profiling)
CHROME_CDP_URL=http://localhost:9222
USE_AUTHENTICATED_SESSION=true
SOCIAL_SCRAPE_DELAY_MS=5000

# Verification
EMAIL_VERIFIER_PROVIDER=mx
VERIFY_TIMEOUT_MS=10000
VERIFY_MAX_AGE_DAYS=30
VERIFY_SMTP_HELO_DOMAIN=leadforge.dev
# ZEROBOUNCE_API_KEY=

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
LOG_JSON=true

EXPORT_DIR=./exports
