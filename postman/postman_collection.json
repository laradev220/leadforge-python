    },
    {
      "name": "5. Data Export",
      "item": [
        {
          "name": "Create Export",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set(\"exportId\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"format\": \"CSV\",\n  \"filters\": {\n    \"scoreMin\": 70,\n    \"websiteStatus\": \"FOUND\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/exports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "exports"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Exports",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/exports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "exports"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Download Export File",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/exports/{{exportId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "exports",
                "{{exportId}}",
                "download"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
