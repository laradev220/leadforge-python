    {
      "name": "4. Lead Scoring & Analysis",
      "item": [
        {
          "name": "List All Leads",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads?page=1&limit=20&scoreMin=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "scoreMin",
                  "value": "50"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Specific Lead",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/{{businessId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{businessId}}"
              ]
            }
          },
          "response": []
        }
